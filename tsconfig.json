{
  "extends": "@tsconfig/svelte/tsconfig.json",
  "compilerOptions": {
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "target": "ES2020",
    "module": "ESNext",
    "strict": true,
    "noEmit": true,
    "types": ["vite/client", "svelte"]
  },
  "include": ["src/**/*", "src/**/*.svelte", "vite.config.ts"]
}
